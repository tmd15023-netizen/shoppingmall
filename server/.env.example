PORT=5000

# MongoDB Atlas 연결 URL
MONGODB_URI=mongodb://USER:PASSWORD@host1:27017,host2:27017,host3:27017/shop-demo?ssl=true&replicaSet=...&authSource=admin&retryWrites=true&w=majority

JWT_SECRET=your-secret-key
JWT_EXPIRES_IN=7d

# 배포된 Vercel 프론트 주소 (여러 개면 쉼표로 구분)
# 예: https://shop-demo.vercel.app,http://localhost:5173
CLIENT_ORIGIN=https://your-app.vercel.app

# PortOne V2 API Secret
PORTONE_API_SECRET=
